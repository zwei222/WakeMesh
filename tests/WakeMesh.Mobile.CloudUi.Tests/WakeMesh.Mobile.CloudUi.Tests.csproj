    <Compile Include="..\..\src\WakeMesh.Mobile\Services\ISecureStorageProvider.cs" Link="Linked\Services\ISecureStorageProvider.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\SecureDeviceCredentialStore.cs" Link="Linked\Services\SecureDeviceCredentialStore.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\IDeviceInfoProvider.cs" Link="Linked\Services\IDeviceInfoProvider.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\LocalDeviceInfoProvider.cs" Link="Linked\Services\LocalDeviceInfoProvider.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\IAuthSettingsStore.cs" Link="Linked\Services\IAuthSettingsStore.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\JsonAuthSettingsStore.cs" Link="Linked\Services\JsonAuthSettingsStore.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\IMsalClientAdapter.cs" Link="Linked\Services\IMsalClientAdapter.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\IAuthService.cs" Link="Linked\Services\IAuthService.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\CloudSync\**\*.cs" Link="Linked\Services\CloudSync\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\WakeMesh.Mobile\Services\CloudManagement\**\*.cs" Link="Linked\Services\CloudManagement\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\WakeMesh.Mobile\ViewModels\ViewModelBase.cs" Link="Linked\ViewModels\ViewModelBase.cs" />
    <Compile Include="..\..\src\WakeMesh.Mobile\ViewModels\Cloud*.cs" Link="Linked\ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
