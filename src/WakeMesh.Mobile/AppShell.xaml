<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WakeMesh.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WakeMesh.Mobile.Views"
    Shell.BackgroundColor="#090D16"
    Shell.ForegroundColor="#F8FAFC"
    Shell.TitleColor="#F8FAFC"
    Shell.TabBarBackgroundColor="#0B0F19"
    Shell.TabBarForegroundColor="#38BDF8"
    Shell.TabBarUnselectedColor="#64748B"
    Shell.NavBarHasShadow="False">

    <TabBar>
        <Tab Title="アラーム" Icon="{x:Null}">
            <ShellContent
                Title="アラーム一覧"
                ContentTemplate="{DataTemplate views:AlarmsPage}"
                Route="AlarmsPage" />
        </Tab>
        <Tab Title="診断と端末" Icon="{x:Null}">
            <ShellContent
                Title="端末診断"
                ContentTemplate="{DataTemplate views:DiagnosticsPage}"
                Route="DiagnosticsPage" />
        </Tab>
        <Tab Title="クラウド管理" Icon="{x:Null}">
            <ShellContent
                Title="クラウド管理"
                ContentTemplate="{DataTemplate views:CloudManagementPage}"
                Route="CloudManagementPage" />
        </Tab>
        <Tab Title="クラウド接続" Icon="{x:Null}">
            <ShellContent
                Title="接続設定"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
