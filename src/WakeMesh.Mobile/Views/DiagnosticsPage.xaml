<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WakeMesh.Mobile.ViewModels"
             x:Class="WakeMesh.Mobile.Views.DiagnosticsPage"
             x:DataType="vm:DiagnosticsViewModel"
             Title="端末診断・状態確認"
             BackgroundColor="{StaticResource SurfaceDark}">

    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="600"
                             Padding="20"
                             Spacing="18"
                             HorizontalOptions="Center">

            <!-- 処理中インジケータ -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource BrandCyanLight}"
                               HeightRequest="24"
                               HorizontalOptions="Center"/>

            <!-- 端末＆システム情報カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📱" FontSize="18"/>
                        <Label Text="端末情報"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSlate100}"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="8" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="端末識別ID:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding DeviceId}" FontSize="12" TextColor="{StaticResource TextSlate100}" LineBreakMode="MiddleTruncation"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="端末表示名:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DeviceDisplayName}" FontSize="12" TextColor="{StaticResource TextSlate100}"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Android OS:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding OsVersionText}" FontSize="12" TextColor="{StaticResource BrandCyanLight}" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- OS権限ステータス＆設定誘導カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🛡️" FontSize="18"/>
                        <Label Text="アラーム実行権限"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSlate100}"/>
                    </HorizontalStackLayout>

                    <Label Text="確実なアラーム鳴動のために必要なAndroid OS権限の状態です。未許可の権限はボタンから直接設定できます。"
                           FontSize="11"
                           TextColor="{StaticResource TextSlate400}"/>

                    <!-- 正確なアラーム -->
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,4" RowSpacing="6">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="正確なアラーム (AlarmClock)" FontSize="13" TextColor="{StaticResource TextSlate100}"/>
                            <Label Text="Android 12+ で必要" FontSize="10" TextColor="{StaticResource TextSlate500}"/>
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ExactAlarmStatus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{Binding ExactAlarmActionText}"
                                Command="{Binding OpenExactAlarmSettingsCommand}"
                                IsEnabled="{Binding CanOpenExactAlarmSettings}"
                                FontSize="12"
                                HeightRequest="36"
                                BackgroundColor="{StaticResource ChipBackground}"
                                TextColor="{StaticResource TextSlate100}"
                                CornerRadius="8"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderDark}"/>

                    <!-- 通知権限 -->
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,4" RowSpacing="6">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="通知権限 (POST_NOTIFICATIONS)" FontSize="13" TextColor="{StaticResource TextSlate100}"/>
                            <Label Text="Android 13+ で必要" FontSize="10" TextColor="{StaticResource TextSlate500}"/>
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding NotificationStatus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandCyanLight}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{Binding NotificationActionText}"
                                Command="{Binding RequestNotificationCommand}"
                                IsEnabled="{Binding CanRequestNotification}"
                                FontSize="12"
                                HeightRequest="36"
                                BackgroundColor="{StaticResource ChipBackground}"
                                TextColor="{StaticResource TextSlate100}"
                                CornerRadius="8"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderDark}"/>

                    <!-- 全画面表示 -->
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,4" RowSpacing="6">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="全画面アラーム表示" FontSize="13" TextColor="{StaticResource TextSlate100}"/>
                            <Label Text="Android 14+ 全画面インテント" FontSize="10" TextColor="{StaticResource TextSlate500}"/>
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding FullScreenStatus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{Binding FullScreenActionText}"
                                Command="{Binding OpenFullScreenSettingsCommand}"
                                IsEnabled="{Binding CanOpenFullScreenSettings}"
                                FontSize="12"
                                HeightRequest="36"
                                BackgroundColor="{StaticResource ChipBackground}"
                                TextColor="{StaticResource TextSlate100}"
                                CornerRadius="8"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource CardBorderDark}"/>

                    <!-- バッテリー最適化 -->
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,4" RowSpacing="6">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="省電力・Doze回避" FontSize="13" TextColor="{StaticResource TextSlate100}"/>
                            <Label Text="バックグラウンド制限の除外" FontSize="10" TextColor="{StaticResource TextSlate500}"/>
                        </VerticalStackLayout>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding BatteryStatus}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource StatusAmber}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{Binding BatteryActionText}"
                                Command="{Binding OpenBatteryOptimizationSettingsCommand}"
                                IsEnabled="{Binding CanOpenBatteryOptimizationSettings}"
                                FontSize="12"
                                HeightRequest="36"
                                BackgroundColor="{StaticResource ChipBackground}"
                                TextColor="{StaticResource TextSlate100}"
                                CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 祝日判定＆安全運用カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🎌" FontSize="18"/>
                        <Label Text="日本の祝日データ"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSlate100}"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="6" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="状態:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding HolidayStatus}" FontSize="12" TextColor="{StaticResource StatusGreen}" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="カバレッジ:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding HolidayCoverageNotice}" FontSize="11" TextColor="{StaticResource TextSlate300}" LineBreakMode="WordWrap"/>
                    </Grid>

                    <Button Text="今すぐ祝日を更新"
                            FontSize="12"
                            HeightRequest="36"
                            BackgroundColor="{StaticResource ChipBackground}"
                            TextColor="{StaticResource TextSlate100}"
                            CornerRadius="8"
                            Command="{Binding RefreshHolidaysCommand}"
                            IsEnabled="{Binding IsBusy, Converter={x:Null}}"/>

                    <Label Text="{Binding HolidayOperationMessage}"
                           FontSize="11"
                           TextColor="{StaticResource BrandCyanLight}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- ネットワーク＆クラウド同期ステータスカード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="☁️" FontSize="18"/>
                        <Label Text="クラウド同期"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSlate100}"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="8" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Entra ID:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AuthStatus}" FontSize="12" TextColor="{StaticResource StatusAmber}" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Azure同期:" FontSize="12" TextColor="{StaticResource TextSlate400}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CloudSyncStatus}" FontSize="12" TextColor="{StaticResource StatusAmber}" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 再診断＆再登録フィードバック -->
            <Label Text="{Binding RescheduledMessage}"
                   FontSize="12"
                   TextColor="{StaticResource StatusGreen}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>

            <!-- 再診断ボタン -->
            <Button Text="診断を再実行・再登録"
                    FontSize="14"
                    BackgroundColor="{StaticResource ChipBackground}"
                    TextColor="{StaticResource TextSlate100}"
                    CornerRadius="12"
                    HeightRequest="44"
                    Margin="0,4,0,24"
                    Command="{Binding RefreshCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
