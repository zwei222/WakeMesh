<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:WakeMesh.Mobile.ViewModels" x:Class="WakeMesh.Mobile.Views.AlarmEditPage" x:DataType="vm:AlarmEditViewModel" Title="{Binding PageTitle}" BackgroundColor="{StaticResource Bg}">
<Grid RowDefinitions="*,Auto"><ScrollView Grid.Row="0"><VerticalStackLayout MaximumWidthRequest="640" HorizontalOptions="Center" Padding="16" Spacing="8">
<Label Text="いつ" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink2}" Margin="0,16,0,0"/><Border BackgroundColor="{StaticResource Surface1}" Padding="16" Stroke="{StaticResource Line}"><VerticalStackLayout Spacing="8">
<TimePicker Time="{Binding TimeOfDay}" Format="HH:mm" HorizontalOptions="Center" FontFamily="OpenSansSemibold" FontSize="48" FontAutoScalingEnabled="False" MinimumHeightRequest="72"/>
<Label Text="名前" FontSize="13" TextColor="{StaticResource Ink2}"/><Entry Text="{Binding Name}" Placeholder="名前"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="毎週" Clicked="OnSelectWeekly" BackgroundColor="{Binding IsWeekly,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding IsWeekly,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="1" Text="1回のみ" Clicked="OnSelectOnce" BackgroundColor="{Binding IsOnce,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding IsOnce,Converter={StaticResource DaySelectedTextColorConverter}}"/></Grid>
<Grid IsVisible="{Binding IsWeekly}" x:Name="WeekdaysWide" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4"><Button Text="月" Clicked="OnToggleMonday" BackgroundColor="{Binding RepeatMonday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatMonday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="1" Text="火" Clicked="OnToggleTuesday" BackgroundColor="{Binding RepeatTuesday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatTuesday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="2" Text="水" Clicked="OnToggleWednesday" BackgroundColor="{Binding RepeatWednesday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatWednesday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="3" Text="木" Clicked="OnToggleThursday" BackgroundColor="{Binding RepeatThursday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatThursday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="4" Text="金" Clicked="OnToggleFriday" BackgroundColor="{Binding RepeatFriday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatFriday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="5" Text="土" Clicked="OnToggleSaturday" BackgroundColor="{Binding RepeatSaturday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatSaturday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="6" Text="日" Clicked="OnToggleSunday" BackgroundColor="{Binding RepeatSunday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatSunday,Converter={StaticResource DaySelectedTextColorConverter}}"/></Grid>
<Grid IsVisible="False" x:Name="WeekdaysNarrow" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*" ColumnSpacing="4" RowSpacing="4"><Button Text="月" Clicked="OnToggleMonday" BackgroundColor="{Binding RepeatMonday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatMonday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="1" Text="火" Clicked="OnToggleTuesday" BackgroundColor="{Binding RepeatTuesday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatTuesday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="2" Text="水" Clicked="OnToggleWednesday" BackgroundColor="{Binding RepeatWednesday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatWednesday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Column="3" Text="木" Clicked="OnToggleThursday" BackgroundColor="{Binding RepeatThursday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatThursday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Row="1" Text="金" Clicked="OnToggleFriday" BackgroundColor="{Binding RepeatFriday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatFriday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Row="1" Grid.Column="1" Text="土" Clicked="OnToggleSaturday" BackgroundColor="{Binding RepeatSaturday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatSaturday,Converter={StaticResource DaySelectedTextColorConverter}}"/><Button Grid.Row="1" Grid.Column="2" Text="日" Clicked="OnToggleSunday" BackgroundColor="{Binding RepeatSunday,Converter={StaticResource DaySelectedColorConverter}}" TextColor="{Binding RepeatSunday,Converter={StaticResource DaySelectedTextColorConverter}}"/></Grid>
<VerticalStackLayout IsVisible="{Binding IsOnce}"><DatePicker Date="{Binding OnceDate}"/><Label Text="過ぎた時刻なら翌日になります" FontSize="13" TextColor="{StaticResource Ink2}"/></VerticalStackLayout>
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="祝日をスキップ"/><Label Text="日本の国民の祝日と振替休日はアラームが鳴りません" FontSize="13" TextColor="{StaticResource Ink2}"/></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding SkipHolidays}"/></Grid></VerticalStackLayout></Border>
<Label Text="鳴り方" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink2}" Margin="0,16,0,0"/><Border BackgroundColor="{StaticResource Surface1}" Padding="16" Stroke="{StaticResource Line}"><VerticalStackLayout Spacing="8"><Label Text="アラーム音"/><Grid ColumnDefinitions="*,Auto"><Picker ItemsSource="{Binding SoundOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedSound}"/><Button Grid.Column="1" Text="{Binding PreviewButtonText}" Command="{Binding TogglePreviewSoundCommand}"/></Grid>
<Label Text="音量"/><Grid ColumnDefinitions="*,Auto"><Slider Minimum="5" Maximum="100" Value="{Binding VolumePercent}"/><Label Grid.Column="1" Text="{Binding VolumePercent,StringFormat='{0}%'}" VerticalOptions="Center"/></Grid>
<Grid ColumnDefinitions="*,Auto"><Label Text="スヌーズ（分）" VerticalOptions="Center"/><Stepper Grid.Column="1" Minimum="1" Maximum="30" Increment="1" Value="{Binding SnoozeMinutes}"/></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="バイブレーション" VerticalOptions="Center"/><Switch Grid.Column="1" IsToggled="{Binding EnableVibration}"/></Grid></VerticalStackLayout></Border>
</VerticalStackLayout></ScrollView>
<VerticalStackLayout Grid.Row="1" BackgroundColor="{StaticResource Bg}" Padding="16,8" Spacing="8"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Crit}" FontSize="13" IsVisible="{Binding HasError}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="キャンセル" Clicked="OnCancelClicked" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" BorderColor="{StaticResource LineStrong}" BorderWidth="1"/><Button Grid.Column="1" Text="保存" Command="{Binding SaveCommand}"/></Grid></VerticalStackLayout></Grid></ContentPage>