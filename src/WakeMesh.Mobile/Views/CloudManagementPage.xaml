<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WakeMesh.Mobile.ViewModels"
             x:Class="WakeMesh.Mobile.Views.CloudManagementPage"
             x:DataType="vm:CloudManagementViewModel"
             Title="クラウド管理"
             BackgroundColor="{StaticResource SurfaceDark}">

    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="640"
                             Padding="16"
                             Spacing="16"
                             HorizontalOptions="Center">

            <!-- 処理中インジケータ -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource BrandCyan}"
                               HeightRequest="24"
                               HorizontalOptions="Center" />

            <!-- 1. 未サインイン / 設定未完時の案内カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource StatusAmber}"
                    BackgroundColor="#291F0A"
                    Padding="16"
                    IsVisible="{Binding NeedsConfigurationOrSignIn}">
                <!-- If not signed in, show notice -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="⚠️" FontSize="18" />
                        <Label Text="クラウド接続の設定が必要です"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StatusAmber}" />
                    </HorizontalStackLayout>

                    <Label Text="端末のクラウド登録やグループ同期を行うには、Microsoft Entra IDへのサインインおよびAPI接続設定が必要です。"
                           FontSize="12"
                           TextColor="{StaticResource TextSlate300}" />

                    <Label Text="{Binding AuthStateText}"
                           FontSize="12"
                           TextColor="{StaticResource TextSlate400}" />

                    <Button Text="クラウド・接続設定を開く"
                            Command="{Binding NavigateToSettingsCommand}"
                            BackgroundColor="{StaticResource BrandCyan}"
                            TextColor="#090D16"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="40"
                            Margin="0,6,0,0"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. FCM通知未接続およびバックグラウンド同期ステータス注記 -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="14,10">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource StatusAmber}" VerticalOptions="Center" />
                        <Label Text="通知・同期方式について"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource StatusAmber}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding FcmNoticeText}"
                           FontSize="11"
                           TextColor="{StaticResource TextSlate400}" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. この端末の登録状態と手動同期カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📱" FontSize="18" />
                        <Label Text="この端末の同期・登録状態"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSlate100}" />
                    </HorizontalStackLayout>

                    <!-- 多重登録防止アラート (RecoveryNeeded) -->
                    <Border IsVisible="{Binding IsRecoveryNeeded}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource StatusRose}"
                            BackgroundColor="#450A0A"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="【多重登録防止アラート】"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusRose}" />
                            <Label Text="前回の端末登録処理が不確定な状態で終了しました。サーバー上に二重に端末を作成することを防ぐため、再登録はブロックされています。"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSlate100}" />
                            <Label Text="{Binding RecoveryReason}"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSlate300}" />
                            <Button Text="確認フラグをリセット"
                                    Command="{Binding ClearRecoveryCommand}"
                                    BackgroundColor="{StaticResource StatusRose}"
                                    TextColor="{StaticResource TextSlate100}"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HeightRequest="32"
                                    HorizontalOptions="Start"
                                    Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 未登録の場合 -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding NotRegistered}">
                        <Label Text="この端末はまだクラウドに登録されていません。登録するとクラウド経由でアラームグループの同期が可能になります。"
                               FontSize="12"
                               TextColor="{StaticResource TextSlate400}" />

                        <Entry Placeholder="端末の表示名 (例: 自宅用タブレット)"
                               Text="{Binding NewDeviceDisplayName}"
                               TextColor="{StaticResource TextSlate100}"
                               PlaceholderColor="{StaticResource TextSlate500}"
                               BackgroundColor="{StaticResource ChipBackground}"
                               HeightRequest="42" />

                        <Button Text="この端末をクラウドに登録"
                                Command="{Binding RegisterCurrentDeviceCommand}"
                                BackgroundColor="{StaticResource BrandCyan}"
                                TextColor="#090D16"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="42" />
                    </VerticalStackLayout>

                    <!-- 登録済みの場合 -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsRegistered}">
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="6" ColumnSpacing="12">
                            <Label Grid.Row="0" Grid.Column="0" Text="端末名:" FontSize="12" TextColor="{StaticResource TextSlate400}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentDeviceDisplayName}" FontSize="12" TextColor="{StaticResource TextSlate100}" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="サーバー端末ID:" FontSize="12" TextColor="{StaticResource TextSlate400}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentServerDeviceIdString}" FontSize="12" TextColor="{StaticResource BrandCyanLight}" LineBreakMode="MiddleTruncation" />

                            <Label Grid.Row="2" Grid.Column="0" Text="登録世代:" FontSize="12" TextColor="{StaticResource TextSlate400}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding RegistrationGeneration, StringFormat='第 {0} 世代'}" FontSize="12" TextColor="{StaticResource TextSlate200}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorderDark}" Margin="0,4" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding LastSyncStatusMessage, FallbackValue='未同期'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSlate200}" />
                                <Label Text="{Binding LastSyncTimeText, StringFormat='最終同期時刻: {0}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSlate500}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="今すぐ同期"
                                    Command="{Binding ManualSyncCommand}"
                                    BackgroundColor="{StaticResource BrandCyan}"
                                    TextColor="#090D16"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="38"
                                    Padding="14,0" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. クラウド端末一覧カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📶" FontSize="18" />
                            <Label Text="登録端末一覧"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSlate100}" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="再読込"
                                Command="{Binding LoadDataCommand}"
                                BackgroundColor="{StaticResource ChipBackground}"
                                TextColor="{StaticResource TextSlate200}"
                                FontSize="11"
                                CornerRadius="6"
                                HeightRequest="32"
                                Padding="10,0" />
                    </Grid>

                    <!-- オフライン・取得失敗時の表示 -->
                    <Border IsVisible="{Binding IsDeviceListError}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource StatusRose}"
                            BackgroundColor="#2D1515"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding DeviceListErrorMessage}"
                                   FontSize="12"
                                   TextColor="#FCA5A5" />
                            <Button Text="再試行"
                                    Command="{Binding LoadDataCommand}"
                                    BackgroundColor="{StaticResource StatusRose}"
                                    TextColor="{StaticResource TextSlate100}"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HeightRequest="30"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 端末一覧コレクション -->
                    <CollectionView ItemsSource="{Binding Devices}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="登録されている端末はありません"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSlate400}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CloudDeviceItemViewModel">
                                <Border StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource CardBorderDark}"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        Padding="12"
                                        Margin="0,4">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextSlate100}" />
                                            <Label Text="{Binding CurrentDeviceBadge}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource BrandCyanLight}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- 反映状態バッジ -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#0F172A"
                                                Padding="6,2">
                                            <Label Text="{Binding SyncStatusText}"
                                                   FontSize="10"
                                                   TextColor="{Binding SyncStatusColorHex}"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                            <Label Text="{Binding Id, StringFormat='ID: {0:D}'}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource TextSlate500}"
                                                   LineBreakMode="MiddleTruncation"
                                                   MaximumWidthRequest="220" />
                                        </HorizontalStackLayout>

                                        <!-- 退役 / 取消 ボタン -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <Button Text="退役"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CloudManagementViewModel}}, Path=RetireDeviceCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding CanRetire}"
                                                    FontSize="10"
                                                    BackgroundColor="#334155"
                                                    TextColor="{StaticResource TextSlate200}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    HeightRequest="26" />
                                            <Button Text="即時取消"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CloudManagementViewModel}}, Path=RevokeDeviceCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    IsEnabled="{Binding CanRevoke}"
                                                    FontSize="10"
                                                    BackgroundColor="#7F1D1D"
                                                    TextColor="{StaticResource TextSlate100}"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    HeightRequest="26" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 5. クラウド アラームグループ一覧カード -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource CardBorderDark}"
                    BackgroundColor="{StaticResource CardDark}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="⏰" FontSize="18" />
                            <Label Text="アラームグループ"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSlate100}" />
                        </HorizontalStackLayout>

                        <Button Grid.Column="1"
                                Text="＋ 新規グループ"
                                Command="{Binding NavigateToCreateGroupCommand}"
                                BackgroundColor="{StaticResource BrandCyan}"
                                TextColor="#090D16"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="6"
                                HeightRequest="32"
                                Padding="12,0" />
                    </Grid>

                    <Label Text="クラウド上で一元管理され、各端末へ同期配信されるアラーム設定です。"
                           FontSize="11"
                           TextColor="{StaticResource TextSlate400}" />

                    <!-- オフライン・取得失敗時の表示 -->
                    <Border IsVisible="{Binding IsGroupListError}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource StatusRose}"
                            BackgroundColor="#2D1515"
                            Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding GroupListErrorMessage}"
                                   FontSize="12"
                                   TextColor="#FCA5A5" />
                            <Button Text="再試行"
                                    Command="{Binding LoadDataCommand}"
                                    BackgroundColor="{StaticResource StatusRose}"
                                    TextColor="{StaticResource TextSlate100}"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HeightRequest="30"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- アラームグループ一覧コレクション -->
                    <CollectionView ItemsSource="{Binding AlarmGroups}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="アラームグループはありません"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSlate400}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CloudAlarmGroupItemViewModel">
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource CardBorderDark}"
                                        BackgroundColor="{StaticResource ChipBackground}"
                                        Padding="14"
                                        Margin="0,6">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Label}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextSlate100}" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding DaysSummary}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource BrandCyanLight}" />
                                                    <Label Text="|"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TextSlate500}" />
                                                    <Label Text="{Binding HolidaySummary}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource TextSlate400}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- サーバー保存ステータス -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="#0F172A"
                                                    Padding="8,4"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding ServerStatusText}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource BrandCyanLight}"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>

                                        <!-- 配信先端末の適用報告一覧 -->
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#0F172A"
                                                Padding="10">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding TargetsSummary}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource TextSlate300}" />

                                                <CollectionView ItemsSource="{Binding Targets}" SelectionMode="None">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CloudAlarmTargetItemViewModel">
                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,2">
                                                                <Label Grid.Column="0"
                                                                       Text="{Binding DeviceDisplayName}"
                                                                       FontSize="11"
                                                                       TextColor="{StaticResource TextSlate200}"
                                                                       VerticalOptions="Center" />
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding TimeString}"
                                                                       FontSize="11"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{StaticResource TextSlate100}"
                                                                       Margin="10,0"
                                                                       VerticalOptions="Center" />
                                                                <Label Grid.Column="2"
                                                                       Text="{Binding ReflectionStatusText}"
                                                                       FontSize="10"
                                                                       TextColor="{StaticResource TextSlate400}"
                                                                       VerticalOptions="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- 操作ボタン -->
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                            <Button Text="編集"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CloudManagementViewModel}}, Path=NavigateToEditGroupCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource BrandCyan}"
                                                    TextColor="#090D16"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    CornerRadius="6"
                                                    HeightRequest="30"
                                                    Padding="12,0" />
                                            <Button Text="削除"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CloudManagementViewModel}}, Path=DeleteGroupCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#7F1D1D"
                                                    TextColor="{StaticResource TextSlate100}"
                                                    FontSize="11"
                                                    CornerRadius="6"
                                                    HeightRequest="30"
                                                    Padding="12,0" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 共通ステータスメッセージ -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="12"
                   TextColor="{StaticResource TextSlate400}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
