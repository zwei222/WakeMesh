<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:WakeMesh.Mobile.ViewModels" xmlns:models="clr-namespace:WakeMesh.Mobile.Models" xmlns:services="clr-namespace:WakeMesh.Mobile.Services" xmlns:controls="clr-namespace:WakeMesh.Mobile.Controls" x:Class="WakeMesh.Mobile.Views.AlarmsPage" x:DataType="vm:AlarmListViewModel" Title="アラーム" BackgroundColor="{StaticResource Bg}">
<Grid RowDefinitions="Auto,*" MaximumWidthRequest="640" HorizontalOptions="Center">
 <VerticalStackLayout Grid.Row="0" Spacing="0">
  <Border IsVisible="{Binding IsRinging}" Margin="16,12,16,4" Padding="16" BackgroundColor="{StaticResource CritSurface}" Stroke="{StaticResource Crit}" StrokeShape="RoundRectangle 12">
   <VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"><controls:StateIndicator StateKey="critical" VerticalOptions="Center"/><Label Grid.Column="1" Text="アラームが鳴っています" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap"/></Grid><Label Text="通知や全画面表示が無効でも、ここで止められます" FontSize="13" TextColor="{StaticResource Ink2}"/>
    <CollectionView x:Name="RingingAlarmList" ItemsSource="{Binding RingingAlarms}" SelectionMode="None"><CollectionView.Triggers><DataTrigger TargetType="CollectionView" Binding="{Binding RingingAlarms.Count}" Value="1"><Setter Property="IsVisible" Value="False"/></DataTrigger></CollectionView.Triggers><CollectionView.ItemTemplate><DataTemplate x:DataType="services:ActiveRingingAlarm"><Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48"><Label Text="{Binding AlarmName}" VerticalOptions="Center"/><Button Grid.Column="1" Text="停止" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlarmListViewModel}}, Path=DismissRingingAlarmCommand}" CommandParameter="{Binding AlarmId}"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button x:Name="StopSingleRingingButton" Text="停止" MinimumHeightRequest="56" IsVisible="False" Command="{Binding DismissAllRingingCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding RingingAlarms.Count}" Value="1"><Setter Property="IsVisible" Value="True"/></DataTrigger></Button.Triggers></Button>
    <Button x:Name="StopAllRingingButton" Text="すべて停止" MinimumHeightRequest="56" Command="{Binding DismissAllRingingCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding RingingAlarms.Count}" Value="1"><Setter Property="IsVisible" Value="False"/></DataTrigger></Button.Triggers></Button>
   </VerticalStackLayout>
  </Border>
  <Border Margin="16,8,16,4" Padding="16" BackgroundColor="{StaticResource CritSurface}" Stroke="{StaticResource Crit}" IsVisible="{Binding ReadinessLevel,Converter={StaticResource ReadinessLevelVisibleConverter},ConverterParameter=Critical}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"><controls:StateIndicator StateKey="critical" VerticalOptions="Center"/><Label Grid.Column="1" Text="時間どおりに鳴らない可能性があります" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap"/></Grid><Label Text="{Binding ReadinessText}" FontSize="13" TextColor="{StaticResource Ink2}"/><Button Text="設定で確認" Clicked="OnReadinessClicked" BackgroundColor="Transparent" BorderColor="{StaticResource Crit}" BorderWidth="1" TextColor="{StaticResource Ink}"/></VerticalStackLayout></Border>
  <Border Margin="16,8,16,4" Padding="16" BackgroundColor="{StaticResource WarnSurface}" Stroke="{StaticResource Warn}" IsVisible="{Binding ReadinessLevel,Converter={StaticResource ReadinessLevelVisibleConverter},ConverterParameter=Warn}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"><controls:StateIndicator StateKey="warn" VerticalOptions="Center"/><Label Grid.Column="1" Text="アラームを鳴らすための設定が不足しています" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap"/></Grid><Label Text="{Binding ReadinessText}" FontSize="13" TextColor="{StaticResource Ink2}"/><Button Text="設定で確認" Clicked="OnReadinessClicked" BackgroundColor="Transparent" BorderColor="{StaticResource LineStrong}" BorderWidth="1" TextColor="{StaticResource Ink}"/></VerticalStackLayout></Border>
  <Border Margin="16,8" Padding="12" BackgroundColor="Transparent" Stroke="Transparent" IsVisible="{Binding IsHolidayDataMissing}"><Label Text="{Binding HolidayNotice}" FontSize="13" TextColor="{StaticResource Ink2}"/></Border>
 </VerticalStackLayout>
 <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAlarmsCommand}"><CollectionView ItemsSource="{Binding Alarms}" SelectionMode="None" Margin="0,0,0,88">
  <CollectionView.EmptyView><VerticalStackLayout Padding="16,24" Spacing="8"><Label Text="アラームはまだありません" FontSize="17" FontAttributes="Bold"/><Label Text="右下の「＋ 追加」から作成できます" FontSize="13" TextColor="{StaticResource Ink2}"/></VerticalStackLayout></CollectionView.EmptyView>
  <CollectionView.Footer><Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{StaticResource Ink2}" Padding="16,8"/></CollectionView.Footer>
  <CollectionView.ItemTemplate><DataTemplate x:DataType="models:LocalAlarmModel"><Grid ColumnDefinitions="*,48,48" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="16,12" MinimumHeightRequest="72" BackgroundColor="{StaticResource Bg}">
   <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnEditAlarmClicked"/></Grid.GestureRecognizers>
   <Label Grid.Row="0" Grid.Column="0" Text="{Binding Time,StringFormat='{0:hh\\:mm}'}" FontFamily="OpenSansSemibold" FontSize="40" FontAutoScalingEnabled="False" TextColor="{StaticResource Ink}"/>
   <Switch Grid.RowSpan="3" Grid.Column="1" IsToggled="{Binding IsEnabled, Mode=OneWay}" VerticalOptions="Center" Toggled="OnAlarmToggled"/>
   <Button Grid.RowSpan="3" Grid.Column="2" Text="⋮" BackgroundColor="Transparent" TextColor="{StaticResource Ink2}" Clicked="OnAlarmMenuClicked"/>
   <Label Grid.Row="1" Grid.Column="0" Text="{Binding .,Converter={StaticResource AlarmDaysTextConverter}}" FontSize="13" TextColor="{StaticResource Ink2}" LineBreakMode="TailTruncation"/>
   <Label Grid.Row="2" Grid.Column="0" Text="{Binding NextFireTime,Converter={StaticResource NextFireTextConverter}}" FontSize="13" TextColor="{StaticResource Ink2}" IsVisible="{Binding NextFireTime,Converter={StaticResource NullableDateVisibleConverter}}"/>
   <FlexLayout Grid.Row="3" Grid.Column="0" Direction="Row" Wrap="Wrap" AlignItems="Center" AlignContent="Start" JustifyContent="Start" Margin="0,2,0,0"><Label Text="端末にアラームを設定できていません" IsVisible="{Binding IsRegistrationFailed}" FontSize="13" TextColor="{StaticResource Crit}" Margin="0,0,12,0" LineBreakMode="WordWrap" FlexLayout.Shrink="1"/><Label Text="祝日判定の範囲外（アラームは鳴ります）" IsVisible="{Binding HasHolidayCoverageWarning}" FontSize="13" TextColor="{StaticResource Warn}" Margin="0,0,12,0" LineBreakMode="WordWrap" FlexLayout.Shrink="1"/><Label Text="祝日は休み" IsVisible="{Binding SkipHolidays}" FontSize="13" TextColor="{StaticResource Ink2}" Margin="0,0,12,0" LineBreakMode="NoWrap" FlexLayout.Shrink="0"/></FlexLayout>
   <BoxView Grid.Row="4" Grid.ColumnSpan="3" HeightRequest="1" Color="{StaticResource Line}"/>
  </Grid></DataTemplate></CollectionView.ItemTemplate>
 </CollectionView></RefreshView>
 <Button Grid.Row="0" Grid.RowSpan="2" Text="＋ 追加" Clicked="OnAddAlarmClicked" HorizontalOptions="End" VerticalOptions="End" Margin="16" CornerRadius="28" MinimumHeightRequest="56" Padding="20,0"/>
</Grid></ContentPage>
