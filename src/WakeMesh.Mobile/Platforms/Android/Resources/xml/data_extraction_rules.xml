<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude tokens, cache, and secure credentials from cloud backup -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="WakeMesh/wakemesh_device_id.txt" />
        <exclude domain="file" path="WakeMesh/wakemesh_auth_settings.json" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude tokens, cache, and secure credentials from device-to-device transfer -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="WakeMesh/wakemesh_device_id.txt" />
        <exclude domain="file" path="WakeMesh/wakemesh_auth_settings.json" />
    </device-transfer>
</data-extraction-rules>
